# Oh My Zsh
alias ze="vim ~/.zshrc"
alias zs="source ~/.zshrc"

# NVIM
alias vim="nvim"

# youtube-dl
alias dl="yt-dlp"
alias dl3="dl --extract-audio --audio-format mp3"
alias dl4="dl -f 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best'"
alias dly='dl4 -o "%(uploader)s - %(title)s (%(duration)ss) [%(resolution)s].%(ext)s"'
alias dlc="dly -i --download-archive archive.txt"
alias dlr='dl -o "$(ran).%(ext)s"'
alias dlk="dlr --cookies $HOME/Downloads/tiktok.com_cookies.txt"

# transmission-remote
alias tm="transmission-remote"

# exa
alias l="eza --icons --group-directories-first -lagh"
alias ll="eza --icons --group-directories-first -lgh"

# move with rsync
alias move='rsync -av --progress --stats --remove-source-files -e "ssh"'

# mediainfo
alias mi="mediainfo"

# Homebrew external ssd
alias xbrew='/Volumes/Lightyear/Homebrew/bin/brew'
